# Connection string de Postgres de Supabase (Settings → Database →
# Connection string → URI). Se acepta cualquiera de estos 4 nombres (ver
# src/lib/db.ts) para ser compatible con lo que inyecte la integración de
# Supabase en Vercel o un valor puesto a mano; basta con rellenar uno.
DATABASE_URL=
POSTGRES_URL=
SUPABASE_DB_URL=
POSTGRES_URL_NON_POOLING=

# Secreto para firmar los JWT de sesión (cualquier cadena larga aleatoria).
JWT_SECRET=

# Email que se da de alta como admin automáticamente al registrarse.
ADMIN_EMAIL=

# API key de Resend, para los correos de recuperación de contraseña.
RESEND_API_KEY=
